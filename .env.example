# Copy to .env (never commit it). Used by `npm run dev` and by docker compose.
# Host port for the container.
CAIRN_PORT=8086

# First user, created only while the user table is empty (no signup UI exists). After the first
# start these are ignored; change the password later through the app, not here.
INITIAL_USERNAME=
INITIAL_PASSWORD=
INITIAL_DISPLAY_NAME=
INITIAL_TIMEZONE=America/Denver

# Reverse proxies whose X-Forwarded-For header names the real client, for the login rate limits.
# Unset: nothing is trusted and each connection's own address is used, which is right when browsers
# reach Cairn directly, but behind a proxy every visitor would share the proxy's address. Set it to
# the proxy's IP, a CIDR, or a hostname (a container name such as `cloudflared` on a shared Docker
# network), comma-separated; `true` trusts any peer, only safe if nothing but the proxy can reach the
# port. Never trust a range that direct visitors come from (Docker's published ports arrive from the
# network's gateway, such as 172.20.0.1).
# TRUST_PROXY=cloudflared

# Dev only: override where the SQLite DB and photos live (default: <repo>/data-dev).
# DATA_DIR=

# Google API key (Places and Geocoding; Weather only if you pick Google as the weather source).
# Optional here: it can also be pasted into Settings, and a key saved in Settings wins over this one.
GOOGLE_API_KEY=
