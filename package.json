{
  "name": "cairn",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @cairn/server\" \"npm run dev -w @cairn/web\"",
    "dev:tailnet": "concurrently -n server,web -c blue,green \"npm run dev -w @cairn/server\" \"npm run dev -w @cairn/web -- --host\"",
    "build": "npm run build -w @cairn/web && npm run build -w @cairn/server",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:journal": "npm run import:journal -w @cairn/server --",
    "e2e": "playwright test -c e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "version": "1.0.0"
}
