# Copy to .env.backup (never commit it). Read only by the backup container; see docs/backup.md.
# Start it with: docker compose --profile backup up -d

# Where backups go, and the password that encrypts them. KEEP THE PASSWORD OFF THIS MACHINE TOO
# (a password manager): without it the backups cannot be read, by anyone, including you.
#
# Cloudflare R2 (S3-compatible; replace the account id and bucket):
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/cairn-backup
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
#
# Other places restic can write (SFTP, Backblaze B2, Google Drive through rclone, a local
# folder, ...): see docs/backup.md. Any restic environment variable can go in this file.

# When to back up each day (24-hour, in TZ), and which time zone that is.
BACKUP_TIME=03:00
TZ=America/Denver

# How many to keep: the newest per day, week and month.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12

# After each backup, also read this share of the stored data to check it is readable (so all of
# it is read over time). Empty = check only the repository's structure.
BACKUP_CHECK_SUBSET=1%

# Optional: a healthchecks.io-style URL. Pinged on success, at /fail on failure, and /start when
# a backup begins, so you hear about a night that never happened.
BACKUP_PING_URL=
